<?xml version="1.0" encoding="utf-8"?>
<!-- v3_Paso 2: Realizar el layout -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v3_Paso 4: Bloque data para conectar la vista con el EdadCaninaModelo -->
    <data>
        <import type="android.view.View"/>
        <import type="es.davante.edadcanina.modelo.Validacion"/>
        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
    </data>



<androidx.appcompat.widget.LinearLayoutCompat
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="ExtraText">

    <!-- Paso 3: Quitar el cierre duplicado del TextView -->
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="32sp"
    android:gravity="center"
    android:layout_marginTop="32dp"
    android:text="@string/txt_titulo">

</TextView>

    <ImageView
        android:layout_width="192dp"
        android:layout_height="wrap_content"
        android:src="@drawable/imgdog"
        android:adjustViewBounds="true"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/input_age"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        />
    <!--Paso 3: Modificar el android:hint por un texto extraido del strings.xml-->
    <!--Paso 5: Modificar la etiqueta EditText (android:inputType, android:maxLength, android:gravity y android:importantForAutofill)-->
    <!-- v3_Paso 4: Enlaces bidireccionales -->
    <!-- v3_Paso 5: Añadiendo app:error para que se limpie o pinte automaticamente -->
    <EditText
        android:id="@+id/age_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="48sp"
        android:hint="@string/hint_edad"
        android:inputType= "number"
        android:maxLength="2"
        android:gravity="center"
        android:importantForAutofill="no"
        android:text="@={modelo.edadTexto}"
        app:errorValidacion="@{modelo.validacion}"/>

    <!-- v3_Paso 4: Enlaces bidireccionales -->
 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:textSize="16sp"
     android:gravity="center"
     android:layout_marginTop="20dp"
     android:id="@+id/result_text"
     android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
     android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}"
     />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/btn_calc"
        android:textSize="22sp"
        android:id="@+id/btn_calc"
        />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>